{
  "name": "dsh-llm-newapi",
  "version": "0.1.0",
  "description": "NewAPI (OpenAI-compatible gateway) chat-completions adapter for the DeepSeek Harness LLM seam. Provider route id 'newapi', display name 'NewAPI'. Dual-face: host half registers the LLM adapter and chat-only model discovery; browser half adds a NewAPI settings section to dsh web.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts/build-client.mjs",
    "cordis.patch.yml",
    "DESIGN.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsc -p tsconfig.json && node scripts/build-host.mjs",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test": "node test/smoke.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "newapi",
    "llm",
    "provider",
    "openai-compatible"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-credentials": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-launch-environment": ">=0.0.1-rc.3",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-settings": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-timeout": ">=0.0.1-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.1"
  },
  "dependencies": {
    "eventsource-parser": "^3.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "esbuild": "^0.25.0",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-connection": "0.0.1-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.0.1-rc.1",
    "@deepseek-ai/dsh-client-runtime": "0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.0.1-rc.1"
  },
  "overrides": {
    "@deepseek-ai/dsh-type-meta": "npm:@deepseek-ai/dsh-brand@0.0.1-rc.1",
    "@deepseek-ai/dsh-compact": "npm:@deepseek-ai/dsh-brand@0.0.1-rc.1",
    "@deepseek-ai/dsh-paths": "npm:@deepseek-ai/dsh-brand@0.0.1-rc.1",
    "@deepseek-ai/dsh-user-interaction": "npm:@deepseek-ai/dsh-brand@0.0.1-rc.1"
  }
}
