@@ -38,7 +38,7 @@ import type { en } from './locales.ts'
 import styles from './ModelsSection.module.css'
 
 /** Per-adapter-family curated field sets (unknown namespaces get the hint alone). */
-type EditorLayout = 'deepseek' | 'pi-ai' | 'unknown'
+type EditorLayout = 'deepseek' | 'pi-ai' | 'newapi' | 'unknown'
 
 /** The public DeepSeek endpoint shown as the deepseek base-URL placeholder. */
 const DEEPSEEK_PUBLIC_BASE_URL = 'https://api.deepseek.com'
@@ -125,6 +125,10 @@ export function pathOps(
 function layoutOf(ns: string): EditorLayout {
   if (ns === 'llm-deepseek') return 'deepseek'
   if (ns === 'llm-pi-ai') return 'pi-ai'
+  // The external dsh-llm-newapi gateway adapter: the same curated card the
+  // pi-ai family renders minus its identity fields (displayName/api), because
+  // this route is fixed by the plugin rather than hand-declared per profile.
+  if (ns === 'llm-newapi') return 'newapi'
   return 'unknown'
 }
 
@@ -329,9 +333,10 @@ export function ProviderEditor(props: ProviderEditorProps): ReactNode {
   /**
    * The curated fields of one known adapter family. The family arrives
    * narrowed so the per-family branches below are total: an unknown namespace
-   * renders the hint instead and never reaches this body.
+   * renders the hint instead and never reaches this body. The `newapi`
+   * family shares the pi-ai card minus its hand-declared identity fields.
    */
-  const curatedFields = (family: 'deepseek' | 'pi-ai'): ReactNode => {
+  const curatedFields = (family: 'deepseek' | 'pi-ai' | 'newapi'): ReactNode => {
     // What a hand-declared route names for itself and nothing else can supply.
